{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workbookDisplayName": {
      "type": "string",
      "defaultValue": "Azure Functions - Issues and Retirement Readiness",
      "metadata": { "description": "Name shown in the Azure Monitor workbook gallery." }
    },
    "workbookId": {
      "type": "string",
      "defaultValue": "[guid(resourceGroup().id, 'azure-functions-issues-workbook')]",
      "metadata": { "description": "Deterministic GUID so redeploys update in place." }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "serializedData": {
      "type": "string",
      "metadata": { "description": "The workbook JSON, serialized as a string." }
    }
  },
  "resources": [
    {
      "type": "microsoft.insights/workbooks",
      "apiVersion": "2022-04-01",
      "name": "[parameters('workbookId')]",
      "location": "[parameters('location')]",
      "kind": "shared",
      "properties": {
        "displayName": "[parameters('workbookDisplayName')]",
        "serializedData": "[parameters('serializedData')]",
        "version": "1.0",
        "sourceId": "azure monitor",
        "category": "workbook",
        "description": "Fleet-wide Azure Functions issue detection with Linux Consumption retirement tracking. Built on Azure Resource Graph only."
      }
    }
  ],
  "outputs": {
    "workbookResourceId": {
      "type": "string",
      "value": "[resourceId('microsoft.insights/workbooks', parameters('workbookId'))]"
    }
  }
}
