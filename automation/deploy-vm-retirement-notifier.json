{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.1.0.0",
  "parameters": {
    "recipients": {
      "type": "array",
      "minLength": 1,
      "metadata": {
        "description": "Email addresses that receive the report, as a JSON array. Example: [\"ops@contoso.com\",\"team@contoso.com\"]"
      }
    },
    "subscriptionIds": {
      "type": "array",
      "defaultValue": "[createArray(subscription().subscriptionId)]",
      "minLength": 1,
      "metadata": {
        "description": "Subscription IDs to check, as a JSON array. Defaults to the deployment subscription. Grant the Logic App identity Reader on each one."
      }
    },
    "retirementHorizonMonths": {
      "type": "int",
      "defaultValue": 6,
      "minValue": 1,
      "maxValue": 60,
      "metadata": {
        "description": "Report sizes that are retired or retire within this many months."
      }
    },
    "workflowName": {
      "type": "string",
      "defaultValue": "vm-retirement-notifier",
      "minLength": 1,
      "maxLength": 80,
      "metadata": {
        "description": "Name of the Logic App (Consumption)."
      }
    },
    "office365ConnectionName": {
      "type": "string",
      "defaultValue": "office365-vm-retirement-notifier",
      "minLength": 1,
      "maxLength": 80,
      "metadata": {
        "description": "Name of the Office 365 Outlook connection. Authorize it after deployment."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Region for the Logic App and the connection."
      }
    },
    "workflowState": {
      "type": "string",
      "defaultValue": "Disabled",
      "allowedValues": [
        "Disabled",
        "Enabled"
      ],
      "metadata": {
        "description": "Keep Disabled until the Office 365 connection is authorized."
      }
    },
    "assignReaderRole": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Grant the Logic App identity Reader on the deployment subscription. Requires Owner or User Access Administrator."
      }
    }
  },
  "variables": {
    "normalizedLocation": "[toLower(replace(parameters('location'), ' ', ''))]",
    "office365ApiId": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', variables('normalizedLocation'), 'office365')]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[parameters('office365ConnectionName')]",
      "location": "[variables('normalizedLocation')]",
      "kind": "V1",
      "properties": {
        "displayName": "VM retirement notifier (authorization required)",
        "api": {
          "id": "[variables('office365ApiId')]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('workflowName')]",
      "location": "[variables('normalizedLocation')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', parameters('office365ConnectionName'))]"
      ],
      "properties": {
        "state": "[parameters('workflowState')]",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.1.0.0",
          "parameters": {
            "$connections": {
              "type": "Object",
              "defaultValue": {}
            },
            "recipients": {
              "type": "Array",
              "defaultValue": "[parameters('recipients')]"
            },
            "subscriptionIds": {
              "type": "Array",
              "defaultValue": "[parameters('subscriptionIds')]"
            },
            "retirementHorizonMonths": {
              "type": "Int",
              "defaultValue": "[parameters('retirementHorizonMonths')]"
            }
          },
          "triggers": {
            "Every_other_Monday_0900": {
              "type": "Recurrence",
              "recurrence": {
                "frequency": "Week",
                "interval": 2,
                "startTime": "2026-10-12T09:00:00",
                "timeZone": "Turkey Standard Time",
                "schedule": {
                  "weekDays": [
                    "Monday"
                  ],
                  "hours": [
                    9
                  ],
                  "minutes": [
                    0
                  ]
                }
              },
              "runtimeConfiguration": {
                "concurrency": {
                  "runs": 1
                }
              }
            }
          },
          "actions": {
            "Initialize_sku_specs": {
              "type": "InitializeVariable",
              "runAfter": {},
              "inputs": {
                "variables": [
                  {
                    "name": "skuSpecs",
                    "type": "object",
                    "value": {}
                  }
                ]
              }
            },
            "Fetch_retirement_catalog": {
              "type": "Http",
              "runAfter": {},
              "inputs": {
                "method": "GET",
                "uri": "https://learn.microsoft.com/en-us/azure/virtual-machines/sizes/lifecycle/retirements-and-capacity-restrictions?accept=text/markdown"
              }
            },
            "Catalog_vm_section": {
              "type": "Compose",
              "runAfter": {
                "Fetch_retirement_catalog": [
                  "Succeeded"
                ]
              },
              "inputs": "@if(contains(string(body('Fetch_retirement_catalog')), '## Retired and retiring VM size series'), first(split(first(split(last(split(string(body('Fetch_retirement_catalog')), '## Retired and retiring VM size series')), '### ADH retired sizes')), '## Impacted VM series')), '')"
            },
            "Retirement_rows": {
              "type": "Query",
              "runAfter": {
                "Catalog_vm_section": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "from": "@split(replace(outputs('Catalog_vm_section'), uriComponentToString('%0D'), ''), uriComponentToString('%0A'))",
                "where": "@and(startsWith(trim(item()), '|'), greaterOrEquals(length(split(trim(item()), '|')), 6), or(contains(toLower(split(trim(item()), '|')[2]), 'announced'), contains(toLower(split(trim(item()), '|')[2]), 'retired')), contains(split(trim(item()), '|')[4], '/'), not(contains(toLower(item()), 'dedicated-hosts')))"
              }
            },
            "If_catalog_unrecognized": {
              "type": "If",
              "runAfter": {
                "Retirement_rows": [
                  "Succeeded"
                ]
              },
              "expression": {
                "and": [
                  {
                    "equals": [
                      "@length(body('Retirement_rows'))",
                      0
                    ]
                  }
                ]
              },
              "actions": {
                "Fail_catalog_parse": {
                  "type": "Terminate",
                  "runAfter": {},
                  "inputs": {
                    "runStatus": "Failed",
                    "runError": {
                      "code": "RetirementCatalogFormatChanged",
                      "message": "Could not parse VM retirement tables from Microsoft Learn; the published markdown structure may have changed."
                    }
                  }
                }
              },
              "else": {
                "actions": {}
              }
            },
            "Retirement_catalog": {
              "type": "Select",
              "runAfter": {
                "If_catalog_unrecognized": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "from": "@body('Retirement_rows')",
                "select": {
                  "series": "@replace(replace(replace(replace(replace(trim(split(trim(item()), '|')[1]), '\\_', '_'), '*', ''), '`', ''), '''', ''), '\\', '')",
                  "date": "@concat(if(equals(length(split(replace(trim(split(trim(item()), '|')[4]), '*', ''), '/')[2]), 2), concat('20', split(replace(trim(split(trim(item()), '|')[4]), '*', ''), '/')[2]), split(replace(trim(split(trim(item()), '|')[4]), '*', ''), '/')[2]), '-', if(equals(length(split(replace(trim(split(trim(item()), '|')[4]), '*', ''), '/')[0]), 1), concat('0', split(replace(trim(split(trim(item()), '|')[4]), '*', ''), '/')[0]), split(replace(trim(split(trim(item()), '|')[4]), '*', ''), '/')[0]), '-', if(equals(length(split(replace(trim(split(trim(item()), '|')[4]), '*', ''), '/')[1]), 1), concat('0', split(replace(trim(split(trim(item()), '|')[4]), '*', ''), '/')[1]), split(replace(trim(split(trim(item()), '|')[4]), '*', ''), '/')[1]))",
                  "guide": "@replace(replace(if(startsWith(trim(first(split(last(split(split(trim(item()), '|')[5], '](')), ')'))), 'http'), trim(first(split(last(split(split(trim(item()), '|')[5], '](')), ')'))), if(startsWith(trim(first(split(last(split(split(trim(item()), '|')[5], '](')), ')'))), '/'), concat('https://learn.microsoft.com', replace(trim(first(split(last(split(split(trim(item()), '|')[5], '](')), ')'))), '/sizes/retirement/', '/sizes/lifecycle/retirement/')), concat('https://learn.microsoft.com/en-us/azure/virtual-machines/sizes/lifecycle/', replace(trim(first(split(last(split(split(trim(item()), '|')[5], '](')), ')'))), '../', '')))), '''', ''), '\\', '')"
                }
              }
            },
            "Risk_query": {
              "type": "Compose",
              "runAfter": {
                "Retirement_catalog": [
                  "Succeeded"
                ]
              },
              "inputs": "// Live retirement catalog parsed from https://learn.microsoft.com/en-us/azure/virtual-machines/sizes/lifecycle/retirements-and-capacity-restrictions\nresources\n| where type =~ 'microsoft.compute/virtualmachines' or type =~ 'microsoft.compute/virtualmachinescalesets'\n| extend Sku = iff(type =~ 'microsoft.compute/virtualmachines', tostring(properties.hardwareProfile.vmSize), tostring(sku.name))\n| where isnotempty(Sku)\n| extend skuClean = tolower(extract('^(.*?)(_promo)?$', 1, Sku))\n| extend skuVer = iff(skuClean matches regex '_v[0-9]+$', extract('_v([0-9]+)$', 1, skuClean), '1'),\n         skuStem = iff(skuClean matches regex '_v[0-9]+$', extract('^(.*)_v[0-9]+$', 1, skuClean), skuClean)\n| extend skuBody = extract('^(?:standard|basic)_([a-z0-9_-]+)$', 1, skuStem)\n| where isnotempty(skuBody)\n| extend catalogRaw = '@{replace(string(body('Retirement_catalog')), '''', '')}'\n| extend catalog = parse_json(catalogRaw)\n| mv-expand entry = catalog limit 400\n| extend seriesLabel = tostring(entry.series), retireDateStr = tostring(entry.date), guideUrl = tostring(entry.guide)\n| extend cleanedLabel = extract('^(.*?)([ ]*[(][vV]1[)])?$', 1, seriesLabel)\n| extend cleanedLabel = extract('^(.*?)([ ]*-?[sS]eries)?$', 1, cleanedLabel)\n| mv-expand rawPart = split(cleanedLabel, '/') limit 20\n| extend part = extract('^[ ]*(.*?)[ ]*$', 1, tostring(rawPart))\n| extend qualExact = iff(part matches regex '^[A-Za-z]+v[0-9]+-[A-Za-z]+[0-9]+[A-Za-z0-9]*$', tolower(strcat('standard_', extract('^[A-Za-z]+v([0-9]+)-([A-Za-z]+[0-9]+[A-Za-z0-9]*)$', 2, part), '_v', extract('^[A-Za-z]+v([0-9]+)-([A-Za-z]+[0-9]+[A-Za-z0-9]*)$', 1, part))), '')\n| extend exactSku = iff(part matches regex '^(?i)(standard|basic)_', tolower(part), qualExact)\n| extend partVer = iff(isempty(exactSku) and part matches regex '_?v[0-9]+$', extract('_?v([0-9]+)$', 1, part), '1'),\n         partStem = iff(isempty(exactSku) and part matches regex '_?v[0-9]+$', extract('^(.*?)_?v[0-9]+$', 1, part), part)\n| extend ruleFam = tolower(extract('^([A-Z]+)', 1, partStem)),\n         ruleFeat = tolower(extract('^[A-Z]+([A-Za-z0-9_]*)$', 1, partStem))\n| extend ruleFeatNorm = strcat(extract('^([^_]*)', 1, ruleFeat), extract('^[^_]*_([^_]*)', 1, ruleFeat), extract('^[^_]*_[^_]*_([^_]*)', 1, ruleFeat))\n| extend skuRem = iff(isempty(exactSku) and isnotempty(ruleFam) and skuBody startswith ruleFam, substring(skuBody, strlen(ruleFam)), '')\n| extend skuPreFeat = extract('^([a-z]*)[0-9]+', 1, skuRem),\n         skuPostFeat = extract('^[a-z]*[0-9]+(?:-[0-9]+)?([a-z0-9]*)', 1, skuRem),\n         skuQual = extract('^[a-z]*[0-9]+(?:-[0-9]+)?[a-z0-9]*_([a-z0-9_]+)$', 1, skuRem)\n| extend skuQualNorm = strcat(extract('^([^_]*)', 1, skuQual), extract('^[^_]*_([^_]*)', 1, skuQual))\n| extend skuFeatNorm = strcat(skuPreFeat, skuPostFeat, skuQualNorm)\n| extend hasExactOverride = tolower(catalogRaw) contains strcat('\"', skuClean, '\"') or tolower(catalogRaw) contains strcat('v', skuVer, '-', skuBody, ' ')\n| where iff(\n    isnotempty(exactSku),\n    skuClean == exactSku,\n    not(hasExactOverride)\n    and skuVer == partVer\n    and isnotempty(skuRem)\n    and skuRem matches regex '^[a-z]*[0-9]+(?:-[0-9]+)?[a-z0-9]*(?:_[a-z0-9_]+)?$'\n    and skuPreFeat in ('', 's')\n    and iff(\n        isnotempty(ruleFeatNorm),\n        skuFeatNorm == ruleFeatNorm or (ruleFeatNorm == 's' and isempty(skuQualNorm) and isempty(skuPreFeat) and skuPostFeat == 'is'),\n        isempty(skuQualNorm) and isempty(skuPreFeat) and (strlen(ruleFam) == 2 or seriesLabel contains '(V1)' or skuPostFeat in ('', 'i', 'r', 'mr'))\n    )\n)\n| extend RetireOn = todatetime(retireDateStr)\n| where isnotnull(RetireOn) and RetireOn <= datetime_add('month', @{parameters('retirementHorizonMonths')}, startofday(now()))\n| extend Days = datetime_diff('day', RetireOn, startofday(now()))\n| join kind=leftouter (resourcecontainers | where type =~ 'microsoft.resources/subscriptions' | project subscriptionId, SubscriptionName = name) on subscriptionId\n| project\n    Status = iff(Days <= 0, 'Retired', strcat('Retires in ', Days, iff(Days == 1, ' day', ' days'))),\n    RetirementDate = substring(tostring(RetireOn), 0, 10),\n    SubscriptionId = subscriptionId,\n    SubscriptionName,\n    ResourceGroup = resourceGroup,\n    ResourceName = name,\n    Type = iff(type =~ 'microsoft.compute/virtualmachines', 'VM', strcat('VMSS (', tostring(toint(sku.capacity)), ')')),\n    Sku,\n    PublishedSeries = seriesLabel,\n    MigrationGuide = guideUrl,\n    Region = location,\n    Days\n| order by Days asc, SubscriptionName asc, ResourceGroup asc, ResourceName asc\n| project-away Days"
            },
            "Find_risky_VMs": {
              "type": "Http",
              "runAfter": {
                "Risk_query": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "method": "POST",
                "uri": "https://management.azure.com/providers/Microsoft.ResourceGraph/resources?api-version=2022-10-01",
                "body": {
                  "subscriptions": "@parameters('subscriptionIds')",
                  "query": "@outputs('Risk_query')",
                  "options": {
                    "resultFormat": "objectArray",
                    "$top": 1000
                  }
                },
                "authentication": {
                  "type": "ManagedServiceIdentity",
                  "audience": "https://management.azure.com/"
                }
              }
            },
            "Check_subscription_access": {
              "type": "Http",
              "runAfter": {},
              "inputs": {
                "method": "POST",
                "uri": "https://management.azure.com/providers/Microsoft.ResourceGraph/resources?api-version=2022-10-01",
                "body": {
                  "subscriptions": "@parameters('subscriptionIds')",
                  "query": "resourcecontainers | where type =~ 'microsoft.resources/subscriptions' | project subscriptionId",
                  "options": {
                    "resultFormat": "objectArray",
                    "$top": 1000
                  }
                },
                "authentication": {
                  "type": "ManagedServiceIdentity",
                  "audience": "https://management.azure.com/"
                }
              }
            },
            "Readable_subscriptions": {
              "type": "Select",
              "runAfter": {
                "Check_subscription_access": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "from": "@coalesce(body('Check_subscription_access')?['data'], json('[]'))",
                "select": "@toLower(item()?['subscriptionId'])"
              }
            },
            "Unreadable_subscriptions": {
              "type": "Query",
              "runAfter": {
                "Readable_subscriptions": [
                  "Succeeded"
                ]
              },
              "inputs": {
                "from": "@parameters('subscriptionIds')",
                "where": "@not(contains(body('Readable_subscriptions'), toLower(item())))"
              }
            },
            "Risky_resources": {
              "type": "Compose",
              "runAfter": {
                "Find_risky_VMs": [
                  "Succeeded"
                ]
              },
              "inputs": "@coalesce(body('Find_risky_VMs')?['data'], json('[]'))"
            },
            "If_risky_resources_found": {
              "type": "If",
              "runAfter": {
                "Initialize_sku_specs": [
                  "Succeeded"
                ],
                "Risky_resources": [
                  "Succeeded"
                ],
                "Unreadable_subscriptions": [
                  "Succeeded"
                ]
              },
              "expression": {
                "and": [
                  {
                    "greater": [
                      "@length(outputs('Risky_resources'))",
                      0
                    ]
                  }
                ]
              },
              "actions": {
                "Select_risky_sku_names": {
                  "type": "Select",
                  "runAfter": {},
                  "inputs": {
                    "from": "@outputs('Risky_resources')",
                    "select": "@toLower(item()?['Sku'])"
                  }
                },
                "Risky_sku_names": {
                  "type": "Compose",
                  "runAfter": {
                    "Select_risky_sku_names": [
                      "Succeeded"
                    ]
                  },
                  "inputs": "@union(body('Select_risky_sku_names'), json('[]'))"
                },
                "Select_risky_scopes": {
                  "type": "Select",
                  "runAfter": {},
                  "inputs": {
                    "from": "@outputs('Risky_resources')",
                    "select": "@concat(toLower(item()?['SubscriptionId']), '|', toLower(item()?['Region']))"
                  }
                },
                "Risky_scopes": {
                  "type": "Compose",
                  "runAfter": {
                    "Select_risky_scopes": [
                      "Succeeded"
                    ]
                  },
                  "inputs": "@union(body('Select_risky_scopes'), json('[]'))"
                },
                "Fetch_regional_skus": {
                  "type": "Foreach",
                  "foreach": "@outputs('Risky_scopes')",
                  "runAfter": {
                    "Risky_sku_names": [
                      "Succeeded"
                    ],
                    "Risky_scopes": [
                      "Succeeded"
                    ]
                  },
                  "runtimeConfiguration": {
                    "concurrency": {
                      "repetitions": 1
                    }
                  },
                  "actions": {
                    "Get_compute_skus": {
                      "type": "Http",
                      "runAfter": {},
                      "runtimeConfiguration": {
                        "paginationPolicy": {
                          "minimumItemCount": 5000
                        }
                      },
                      "inputs": {
                        "method": "GET",
                        "uri": "https://management.azure.com/subscriptions/@{split(item(), '|')[0]}/providers/Microsoft.Compute/skus?api-version=2021-07-01&$filter=@{uriComponent(concat('location eq ''', split(item(), '|')[1], ''''))}",
                        "authentication": {
                          "type": "ManagedServiceIdentity",
                          "audience": "https://management.azure.com/"
                        }
                      }
                    },
                    "Matched_regional_skus": {
                      "type": "Query",
                      "runAfter": {
                        "Get_compute_skus": [
                          "Succeeded"
                        ]
                      },
                      "inputs": {
                        "from": "@coalesce(body('Get_compute_skus')?['value'], json('[]'))",
                        "where": "@and(equals(toLower(coalesce(item()?['resourceType'], '')), 'virtualmachines'), contains(outputs('Risky_sku_names'), toLower(coalesce(item()?['name'], ''))))"
                      }
                    },
                    "Regional_sku_pairs": {
                      "type": "Select",
                      "runAfter": {
                        "Matched_regional_skus": [
                          "Succeeded"
                        ]
                      },
                      "inputs": {
                        "from": "@body('Matched_regional_skus')",
                        "select": "@concat('\"', toLower(item()?['name']), '\":{\"vCPUs\":\"', if(not(empty(xpath(xml(addProperty(json('{}'), 'root', addProperty(json('{}'), 'cap', coalesce(item()?['capabilities'], json('[]'))))), 'string(/root/cap[name=\"vCPUsAvailable\"]/value)'))), xpath(xml(addProperty(json('{}'), 'root', addProperty(json('{}'), 'cap', coalesce(item()?['capabilities'], json('[]'))))), 'string(/root/cap[name=\"vCPUsAvailable\"]/value)'), if(not(empty(xpath(xml(addProperty(json('{}'), 'root', addProperty(json('{}'), 'cap', coalesce(item()?['capabilities'], json('[]'))))), 'string(/root/cap[name=\"vCPUs\"]/value)'))), xpath(xml(addProperty(json('{}'), 'root', addProperty(json('{}'), 'cap', coalesce(item()?['capabilities'], json('[]'))))), 'string(/root/cap[name=\"vCPUs\"]/value)'), 'n/a')), '\",\"memoryGB\":\"', if(not(empty(xpath(xml(addProperty(json('{}'), 'root', addProperty(json('{}'), 'cap', coalesce(item()?['capabilities'], json('[]'))))), 'string(/root/cap[name=\"MemoryGB\"]/value)'))), xpath(xml(addProperty(json('{}'), 'root', addProperty(json('{}'), 'cap', coalesce(item()?['capabilities'], json('[]'))))), 'string(/root/cap[name=\"MemoryGB\"]/value)'), 'n/a'), '\"}')"
                      }
                    },
                    "Merge_regional_skus": {
                      "type": "SetVariable",
                      "runAfter": {
                        "Regional_sku_pairs": [
                          "Succeeded"
                        ]
                      },
                      "inputs": {
                        "name": "skuSpecs",
                        "value": "@mergeObjects(variables('skuSpecs'), json(concat('{', join(body('Regional_sku_pairs'), ','), '}')))"
                      }
                    }
                  }
                },
                "Risk_table": {
                  "type": "Table",
                  "runAfter": {
                    "Fetch_regional_skus": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "from": "@outputs('Risky_resources')",
                    "format": "HTML",
                    "columns": [
                      {
                        "header": "Status",
                        "value": "@item()?['Status']"
                      },
                      {
                        "header": "Retirement date",
                        "value": "@item()?['RetirementDate']"
                      },
                      {
                        "header": "Subscription ID",
                        "value": "@item()?['SubscriptionId']"
                      },
                      {
                        "header": "Subscription name",
                        "value": "@item()?['SubscriptionName']"
                      },
                      {
                        "header": "Resource group",
                        "value": "@item()?['ResourceGroup']"
                      },
                      {
                        "header": "Resource name",
                        "value": "@item()?['ResourceName']"
                      },
                      {
                        "header": "Type",
                        "value": "@item()?['Type']"
                      },
                      {
                        "header": "SKU",
                        "value": "@item()?['Sku']"
                      },
                      {
                        "header": "vCPUs",
                        "value": "@coalesce(variables('skuSpecs')?[toLower(item()?['Sku'])]?['vCPUs'], 'n/a')"
                      },
                      {
                        "header": "Memory (GiB)",
                        "value": "@coalesce(variables('skuSpecs')?[toLower(item()?['Sku'])]?['memoryGB'], 'n/a')"
                      },
                      {
                        "header": "Published series",
                        "value": "@item()?['PublishedSeries']"
                      },
                      {
                        "header": "Migration guide",
                        "value": "@concat('GUIDE_HREF_START', item()?['MigrationGuide'], 'GUIDE_HREF_MIDOpen guideGUIDE_HREF_END')"
                      },
                      {
                        "header": "Region",
                        "value": "@item()?['Region']"
                      }
                    ]
                  }
                },
                "Email_table": {
                  "type": "Compose",
                  "runAfter": {
                    "Risk_table": [
                      "Succeeded"
                    ]
                  },
                  "inputs": "@replace(replace(replace(replace(replace(replace(replace(body('Risk_table'), '<table>', '<table style=\"border-collapse:collapse;font-family:Segoe UI,Arial,sans-serif;font-size:12px\">'), '<th>', '<th style=\"border:1px solid #c8c6c4;padding:4px 8px;background:#f3f2f1;text-align:left\">'), '<td>Retired</td>', '<td style=\"border:1px solid #c8c6c4;padding:4px 8px;color:#a4262c;font-weight:600\">Retired</td>'), '<td>', '<td style=\"border:1px solid #c8c6c4;padding:4px 8px\">'), 'GUIDE_HREF_START', '<a href=\"'), 'GUIDE_HREF_MID', '\">'), 'GUIDE_HREF_END', '</a>')"
                },
                "Send_email": {
                  "type": "ApiConnection",
                  "runAfter": {
                    "Email_table": [
                      "Succeeded"
                    ]
                  },
                  "inputs": {
                    "host": {
                      "connection": {
                        "name": "@parameters('$connections')['office365']['connectionId']"
                      }
                    },
                    "method": "post",
                    "path": "/v2/Mail",
                    "body": {
                      "To": "@{join(parameters('recipients'), ';')}",
                      "Subject": "Azure VM retirement: @{length(outputs('Risky_resources'))} VMs or scale sets need action",
                      "Body": "<p style=\"font-family:Segoe UI,Arial,sans-serif;font-size:14px\">@{length(outputs('Risky_resources'))} VMs or scale sets use sizes that are retired or retire within @{parameters('retirementHorizonMonths')} months. Resize or migrate them before the retirement date.</p>@{outputs('Email_table')}<p style=\"font-family:Segoe UI,Arial,sans-serif;font-size:12px;color:#605e5c\">Scanned @{sub(length(parameters('subscriptionIds')), length(body('Unreadable_subscriptions')))} of @{length(parameters('subscriptionIds'))} subscriptions@{if(greater(int(coalesce(body('Find_risky_VMs')?['totalRecords'], 0)), length(outputs('Risky_resources'))), concat('; showing the first ', string(length(outputs('Risky_resources'))), ' of ', string(body('Find_risky_VMs')?['totalRecords'])), '')}. Retirement dates and guides are fetched live from Microsoft Learn; vCPU and memory specs come from the Azure Compute SKUs API. Check the linked guide for regional extensions and validate disks, images, and quota before resizing. <a href=\"https://learn.microsoft.com/en-us/azure/virtual-machines/sizes/lifecycle/retirements-and-capacity-restrictions\">Retirement dates and guidance</a></p>",
                      "Importance": "High"
                    }
                  }
                }
              },
              "else": {
                "actions": {}
              }
            },
            "If_access_missing": {
              "type": "If",
              "runAfter": {
                "If_risky_resources_found": [
                  "Succeeded"
                ]
              },
              "expression": {
                "and": [
                  {
                    "greater": [
                      "@length(body('Unreadable_subscriptions'))",
                      0
                    ]
                  }
                ]
              },
              "actions": {
                "Fail_run": {
                  "type": "Terminate",
                  "runAfter": {},
                  "inputs": {
                    "runStatus": "Failed",
                    "runError": {
                      "code": "MissingReaderAccess",
                      "message": "The Logic App identity has no Reader access to: @{join(body('Unreadable_subscriptions'), ', ')}"
                    }
                  }
                }
              },
              "else": {
                "actions": {}
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "office365": {
                "connectionId": "[resourceId('Microsoft.Web/connections', parameters('office365ConnectionName'))]",
                "connectionName": "[parameters('office365ConnectionName')]",
                "id": "[variables('office365ApiId')]"
              }
            }
          }
        }
      }
    },
    {
      "condition": "[parameters('assignReaderRole')]",
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2022-09-01",
      "name": "[format('{0}-reader-{1}', take(parameters('workflowName'), 40), uniqueString(resourceGroup().id))]",
      "subscriptionId": "[subscription().subscriptionId]",
      "location": "[variables('normalizedLocation')]",
      "dependsOn": [
        "[resourceId('Microsoft.Logic/workflows', parameters('workflowName'))]"
      ],
      "properties": {
        "mode": "Incremental",
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "parameters": {
          "principalId": {
            "value": "[reference(resourceId('Microsoft.Logic/workflows', parameters('workflowName')), '2019-05-01', 'full').identity.principalId]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "principalId": {
              "type": "string"
            }
          },
          "variables": {
            "readerRoleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'acdd72a7-3385-48ef-bd42-f606fba81ae7')]"
          },
          "resources": [
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "name": "[guid(subscription().id, parameters('principalId'), variables('readerRoleDefinitionId'))]",
              "properties": {
                "roleDefinitionId": "[variables('readerRoleDefinitionId')]",
                "principalId": "[parameters('principalId')]",
                "principalType": "ServicePrincipal"
              }
            }
          ]
        }
      }
    }
  ],
  "outputs": {
    "workflowResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Logic/workflows', parameters('workflowName'))]"
    },
    "workflowPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Logic/workflows', parameters('workflowName')), '2019-05-01', 'full').identity.principalId]"
    },
    "office365ConnectionResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Web/connections', parameters('office365ConnectionName'))]"
    },
    "postDeploymentSteps": {
      "type": "string",
      "value": "1) Open the Office 365 connection > Edit API connection > Authorize > Save. 2) Grant the Logic App identity Reader on every other subscription in subscriptionIds. 3) Enable the Logic App. It runs every other Monday at 09:00 (Turkey Standard Time)."
    }
  }
}
