{
  "name": "Audit-RHEL-Hybrid-Benefit",
  "properties": {
    "description": "This policy will enforce usage of hybrid use benefit on RedHat bring-your-own-subscription (BYOS) operating systems.",
    "displayName": "Enforce Redhat hybrid use benefit",
    "metadata": {
      "category": "Compute",
      "version": "1.0.0"
    },
    "mode": "All",
    "parameters": {
      "effect": {
        "allowedValues": [
          "Deny",
          "Audit",
          "Disabled"
        ],
        "defaultValue": "Audit",
        "metadata": {
          "description": "Deny, Audit or Disabled the execution of the Policy",
          "displayName": "Effect"
        },
        "type": "String"
      },
      "imageSkuPattern": {
        "defaultValue": "rhel-*",
        "metadata": {
          "description": "Pattern for the Red Hat BYOS image SKU (Microsoft.Compute/imageSKU) that the policy applies to. It can contain one * wildcard and is not case sensitive. The default rhel-* matches every SKU of the rhel-byos offer, including RHEL versions that are published later. Narrow it, for example to rhel-lvm9*, to limit the policy to some versions.",
          "displayName": "Image SKU pattern"
        },
        "type": "String"
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "in": [
              "Microsoft.Compute/virtualMachines",
              "Microsoft.Compute/VirtualMachineScaleSets"
            ]
          },
          {
            "equals": "redhat",
            "field": "Microsoft.Compute/imagePublisher"
          },
          {
            "equals": "rhel-byos",
            "field": "Microsoft.Compute/imageOffer"
          },
          {
            "field": "Microsoft.Compute/imageSKU",
            "like": "[parameters('imageSkuPattern')]"
          },
          {
            "field": "Microsoft.Compute/licenseType",
            "notEquals": "RHEL_BYOS"
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]"
      }
    },
    "policyType": "Custom"
  },
  "type": "Microsoft.Authorization/policyDefinitions"
}